# App auth (single admin account seeded on first boot)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Session cookie signing secret (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SESSION_SECRET=change-me-too

# Fernet key used to encrypt Telegram sessions/api_hash at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_ENCRYPTION_KEY=

# SQLite database path (relative to backend/)
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Number of in-process asyncio workers for bulk profile-edit jobs
BULK_JOB_WORKER_COUNT=3
